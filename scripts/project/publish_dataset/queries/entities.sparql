prefix ext: <http://mu.semte.ch/vocabularies/ext/>
prefix skos: <http://www.w3.org/2004/02/skos/core#>
prefix oa: <http://www.w3.org/ns/oa#>
prefix org: <http://www.w3.org/ns/org#>
prefix eli: <http://data.europa.eu/eli/ontology#>
prefix prov: <http://www.w3.org/ns/prov#>
prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 

insert {
  graph <http://mu.semte.ch/graphs/tmp-export> {
    ?annotation a ext:downloadResource .
    ?target a ext:downloadResource .
    ?statement a ext:downloadResource .
    ?activity a ext:downloadResource .
    ?agent a ext:downloadResource .
  }
}
where {
  {{ organizationFilter }}
  
  ?annotation oa:hasBody ?statement .
  ?annotation oa:hasTarget ?target .
  ?target oa:hasSource ?expression .
  ?statement a rdf:Statement .

  optional {
    ?activity prov:generated ?annotation .

    optional {
      ?activity prov:wasAssociatedWith ?agent .
    }
  }

  {
    ?work eli:is_realized_by ?expression .
    ?work eli:passed_by ?org .
    ?organization org:hasSubOrganization* ?org .
  }
  union {
    ?expression ext:owningBody ?organization .
  }
}
