PREFIX private-ds-ex: <http://decide.data.gift/datasets/example/60e19fdf-b549-41b9-9adf-420379285127/> 
PREFIX public-ds-ex: <http://decide.data.gift/datasets/example/1ae2da8e-9889-426b-a7e8-9360c15ba2cd/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX mu: <http://mu.semte.ch/vocabularies/core/>
PREFIX dct: <http://purl.org/dc/terms/>
DELETE {
  graph ?g {
    public-ds-ex:distribution dct:format "application/sparql-query" .

    private-ds-ex:distribution dct:format "application/sparql-query" .
   
    public-ds-ex:distribution dct:modified ?publicMod .
    private-ds-ex:distribution dct:modified ?privateMod .
  }
}
INSERT {
  graph ?g {
    public-ds-ex:dataservice a dcat:DataService ;
    mu:uuid "53a8f248-9a44-47d6-91c6-78cc8bdaa940" ;
    dcat:servesDataset public-ds-ex:dataset ;
    dcat:endpointURL <https://ds.decide.lblod.info/api/private/sparql> ;
    dct:conformsTo <https://www.w3.org/TR/sparql11-protocol/> ;
    dct:description "A demonstration public SPARQL endpoint for the DECIDe project, only able to read publicly accessible data." ;
    dct:format <https://www.iana.org/assignments/media-types/application/json> ;
    dct:modified ?now .

    private-ds-ex:dataservice a dcat:DataService ;
    mu:uuid  "9149add0-becb-48b6-a30c-0455fda57214" ;
    dcat:servesDataset private-ds-ex:dataset ;
    dcat:endpointURL <https://ds.decide.lblod.info/api/private/sparql> ;
    dct:conformsTo <https://www.w3.org/TR/sparql11-protocol/> ;
    dct:description "A demonstration private SPARQL endpoint for the DECIDe project, with access rights depending on the role used for logging in." ;
    dct:format <https://www.iana.org/assignments/media-types/application/json> ;
    dct:modified ?now .

    public-ds-ex:distribution dct:modified ?now .
    private-ds-ex:distribution dct:modified ?now .
  }
}


WHERE {
  GRAPH ?g {
    public-ds-ex:distribution dct:format "application/sparql-query" .

    private-ds-ex:distribution dct:format "application/sparql-query" .

    BIND(NOW() AS ?now)

    OPTIONAL {
      public-ds-ex:distribution dct:modified ?publicMod .
    }
    OPTIONAL {
      private-ds-ex:distribution dct:modified ?privateMod .
    }
  }
}