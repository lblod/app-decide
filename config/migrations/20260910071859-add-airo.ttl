<http://lblod.data.gift/id/pipelines/pdf-to-eli/v1.0.0> a airo:AISystem ;
  dcterms:title "Transform a PDF to an ELI work with the content stored as an ELI expression"@en ;
  dcterms:description "A system to fetch a remote or local PDF, extract its content and store it as ELI work + ELI expression."@en  ;
  airo:hasComponent <http://lblod.data.gift/id/services/pdf-content-extraction/v1.0.0> .

<http://lblod.data.gift/id/pipelines/pdf-to-enriched/v1.0.0> a airo:AISystem ;
  dcterms:title "Extract decisions from PDFs and enrich the data with annotations"@en ;
  dcterms:description "A system to fetch a remote or local PDF, extract its content, store it as ELI work + ELI expression, and enrich the data with by annotating linked entities."@en  ;
  airo:hasComponent <http://lblod.data.gift/id/services/pdf-content-extraction/v1.0.0> ,
    <http://lblod.data.gift/id/services/ner/v1.0.0> ,
    <http://lblod.data.gift/id/services/nel/v1.0.0> .

<http://lblod.data.gift/id/pipelines/json-to-enriched/v1.0.0> a airo:AISystem ;
  dcterms:title "JSON to enriched Linked Data system"@en ;
  dcterms:description "A system that receives structured JSON data and extracts ELI Work and Expression resources from it.  The extracted resources are enriched with annotations identifying entities."@en ;
  airo:hasComponent <http://lblod.data.gift/id/services/ner/v1.0.0> ,
    <http://lblod.data.gift/id/services/nel/v1.0.0> .

<http://lblod.data.gift/id/pipelines/ner-and-nel-annotations/v1.0.0> a airo:AISystem ;
  dcterms:title "Extract and link entities in ELI resources"@en ;
  dcterms:description "A system that extracts and links entities, as linked data, to ELI Expressions"@en ;
  airo:hasComponent <http://lblod.data.gift/id/services/ner/v1.0.0> ,
    <http://lblod.data.gift/id/services/nel/v1.0.0> .

<http://lblod.data.gift/id/pipelines/nel-annotations/v1.0.0> a airo:AISystem ;
  dcterms:title "Link entities in ELI resources to Linked Data"@en ;
  dcterms:description "A system that extracts and links entities, as linked data, to ELI Expressions"@en ;
  airo:hasComponent <http://lblod.data.gift/id/services/nel/v1.0.0> .

<http://lblod.data.gift/id/pipelines/codelist-labeling-evaluation/v1.0.0> a airo:AISystem ;
  dcterms:title "Decision Labeling with Codelist System"@en ;
  dcterms:description "A system to label ELI expression with concepts from a skos:ConceptScheme and optionally add positive or negative impact."@en ;
  airo:hasComponent <http://lblod.data.gift/id/services/codelist-labeling/v1.0.0> .

<http://lblod.data.gift/id/pipelines/question-answering/v1.0.0> a airo:AISystem ;
  dcterms:title "Answer questions on local decisions."@en ;
  dcterms:description "A system that tries to answer user questions based on information found in relevant local decisions."@en ;
  airo:hasComponent <http://lblod.data.gift/id/services/question-answering/v1.0.0> .

