input:text-input a airo:Input ;
  dcterms:type "string"^^xsd:string .


metric:PrecisionMetric a dqv:Metric ;
  dqv:inDimension dim:Accuracy ;
  dqv:expectedDataType xsd:decimal ;
  rdfs:label "Precision Accuracy Metric" ;
  rdfs:comment "The proportion of predicted positive instances that are actually positive." .

metric:RecallMetric a dqv:Metric ;
  dqv:inDimension dim:Accuracy ;
  dqv:expectedDataType xsd:decimal ;
  rdfs:label "Recall Accuracy Metric" ;
  rdfs:comment "The proportion of actual positive instances that are correctly identified." .

metric:F1ScoreMetric a dqv:Metric ;
  dqv:inDimension dim:Accuracy ;
  dqv:expectedDataType xsd:decimal ;
  rdfs:label "F1 Score metric" ;
  rdfs:comment "The harmonic mean of precision and recall, balancing both into a single performance measure." .

dim:Accuracy a dqv:Dimension ;
  rdfs:label "Accuracy" .


