  PREFIX odrl: <http://www.w3.org/ns/odrl/2/> 
  PREFIX private-ds-ex: <http://decide.data.gift/datasets/example/60e19fdf-b549-41b9-9adf-420379285127/> 
  PREFIX public-ds-ex: <http://decide.data.gift/datasets/example/1ae2da8e-9889-426b-a7e8-9360c15ba2cd/> 
  DELETE {
    GRAPH ?g {
      ?s ?p ?o.
      ?o ?pp ?oo.
    }
  }WHERE {
    GRAPH ?g {
      VALUES(?s ?p) {
        (public-ds-ex:policy odrl:permission)
        (public-ds-ex:policy odrl:prohibition)
        (private-ds-ex:policy odrl:permission)
        (private-ds-ex:policy odrl:prohibition)
      }
      ?s ?p ?o.
      ?o ?pp ?oo.
    }
  }